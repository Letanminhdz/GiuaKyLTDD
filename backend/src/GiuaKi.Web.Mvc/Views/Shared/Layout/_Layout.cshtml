@using Abp.Configuration.Startup
@using Abp.Web.Security.AntiForgery
@inject IAbpAntiForgeryManager AbpAntiForgeryManager
@{
    AbpAntiForgeryManager.SetCookie(Context);
    var pageTitle = !string.IsNullOrWhiteSpace(ViewBag.Title) ? ViewBag.Title : "EduTest - Exam Workspace";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentUserName = User.Identity?.Name ?? "";
    var isStudent = currentUserName.Equals("user", StringComparison.OrdinalIgnoreCase) || string.Equals(currentController, "Student", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@pageTitle</title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <style>
        :root {
            --primary: #5A4FCF;
            --primary-hover: #483EA8;
            --primary-light: #EDE9FE;
            --bg-body: #F8FAFC;
            --card-bg: #FFFFFF;
            --text-main: #1E293B;
            --text-muted: #64748B;
            --border-color: #E2E8F0;
            --danger: #EF4444;
            --danger-light: #FEE2E2;
            --success: #10B981;
            --success-light: #D1FAE5;
            --sidebar-width: 260px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            color: var(--text-main);
        }

        /* ==========================================================================
           CHẾ ĐỘ MOBILE CHO TÀI KHOẢN HỌC VIÊN (USER) CHUẨN FIGMA
           ========================================================================== */
        @if (isStudent)
        {
            <text>
            body {
                background-color: #E2E8F0;
                background-image: radial-gradient(#CBD5E1 1.2px, transparent 1.2px);
                background-size: 20px 20px;
                display: flex;
                justify-content: center;
                align-items: center;
                min-height: 100vh;
                padding: 24px 12px;
            }

            .mobile-phone-container {
                width: 430px;
                max-width: 100%;
                min-height: 860px;
                height: 92vh;
                max-height: 920px;
                background: #FFFFFF;
                border-radius: 44px;
                box-shadow: 0 30px 80px rgba(15, 23, 42, 0.22), 0 0 0 10px #1E293B, 0 0 0 12px #94A3B8;
                display: flex;
                flex-direction: column;
                overflow: hidden;
                position: relative;
            }

            @@media (max-width: 480px) {
                body {
                    padding: 0;
                    background: #FFFFFF;
                    background-image: none;
                }
                .mobile-phone-container {
                    width: 100%;
                    height: 100vh;
                    max-height: 100vh;
                    border-radius: 0;
                    box-shadow: none;
                }
            }

            /* Phone Status Bar (Dynamic Island) */
            .phone-status-bar {
                height: 40px;
                padding: 10px 24px 0 24px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                background: #FFFFFF;
                flex-shrink: 0;
                z-index: 50;
            }

            .phone-time {
                font-size: 13px;
                font-weight: 700;
                color: #0F172A;
            }

            .phone-notch {
                width: 90px;
                height: 22px;
                background: #0F172A;
                border-radius: 16px;
                margin-top: -6px;
            }

            .phone-icons {
                display: flex;
                gap: 6px;
                font-size: 11px;
                color: #0F172A;
            }

            /* Phone App Top Header khớp Figma */
            .phone-app-header {
                padding: 14px 22px 10px 22px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                background: #FFFFFF;
                flex-shrink: 0;
                z-index: 40;
            }

            .user-greeting-box .greeting-sub {
                font-size: 12px;
                color: #64748B;
                display: block;
                line-height: 1.2;
            }

            .user-greeting-box .greeting-name {
                font-size: 20px;
                font-weight: 800;
                color: #1E293B;
                line-height: 1.2;
                margin-top: 2px;
            }

            .header-right-actions {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .phone-user-avatar {
                width: 38px;
                height: 38px;
                border-radius: 50%;
                background: #EDE9FE;
                color: var(--primary);
                font-size: 14px;
                font-weight: 700;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .phone-logout-btn {
                width: 34px;
                height: 34px;
                border-radius: 50%;
                background: #F8FAFC;
                border: 1px solid var(--border-color);
                color: #64748B;
                display: flex;
                align-items: center;
                justify-content: center;
                text-decoration: none;
                font-size: 12.5px;
                transition: all 0.15s;
            }

            .phone-logout-btn:hover {
                background: #FEE2E2;
                color: #EF4444;
                border-color: #FECACA;
            }

            /* Phone Scrollable Body Content */
            .phone-screen-content {
                flex: 1;
                overflow-y: auto;
                padding: 14px 20px 24px 20px;
                -webkit-overflow-scrolling: touch;
            }

            .phone-screen-content::-webkit-scrollbar {
                width: 4px;
            }
            .phone-screen-content::-webkit-scrollbar-thumb {
                background: #CBD5E1;
                border-radius: 4px;
            }

            /* Phone Bottom Navigation Bar khớp Figma */
            .phone-bottom-nav {
                height: 64px;
                background: #FFFFFF;
                border-top: 1px solid #F1F5F9;
                display: flex;
                align-items: center;
                justify-content: space-around;
                padding: 0 8px;
                flex-shrink: 0;
                z-index: 50;
                box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.03);
            }

            .phone-nav-tab {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 4px;
                color: #94A3B8;
                text-decoration: none;
                font-size: 11px;
                font-weight: 600;
                transition: color 0.15s;
                flex: 1;
                padding: 6px 0;
            }

            .phone-nav-tab i {
                font-size: 17px;
            }

            .phone-nav-tab.active {
                color: var(--primary);
            }
            </text>
        }
        else
        {
            <text>
            /* ==========================================================================
               CHẾ ĐỘ DESKTOP DÀNH CHO ADMIN
               ========================================================================== */
            body {
                background-color: var(--bg-body);
                display: flex;
                min-height: 100vh;
            }

            .edutest-sidebar {
                width: var(--sidebar-width);
                background: #FFFFFF;
                border-right: 1px solid var(--border-color);
                display: flex;
                flex-direction: column;
                position: fixed;
                top: 0;
                bottom: 0;
                left: 0;
                z-index: 100;
            }

            .sidebar-brand {
                padding: 24px 20px 20px 20px;
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .brand-logo-badge {
                width: 38px;
                height: 38px;
                background: var(--primary);
                color: #FFFFFF;
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
                font-weight: 700;
            }

            .brand-text h2 {
                font-size: 17px;
                font-weight: 700;
                color: var(--text-main);
                line-height: 1.2;
            }

            .brand-text p {
                font-size: 12px;
                color: var(--text-muted);
            }

            .sidebar-menu {
                flex: 1;
                padding: 16px 12px;
                overflow-y: auto;
            }

            .menu-section-title {
                font-size: 11px;
                font-weight: 700;
                color: #94A3B8;
                letter-spacing: 0.5px;
                padding: 14px 12px 6px 12px;
                text-transform: uppercase;
            }

            .nav-item {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 10px 14px;
                border-radius: 8px;
                color: var(--text-muted);
                text-decoration: none;
                font-size: 14px;
                font-weight: 500;
                margin-bottom: 4px;
                transition: all 0.15s ease-in-out;
            }

            .nav-item i {
                font-size: 16px;
                width: 20px;
                text-align: center;
            }

            .nav-item:hover {
                background: #F1F5F9;
                color: var(--text-main);
            }

            .nav-item.active {
                background: var(--primary-light);
                color: var(--primary);
                font-weight: 600;
            }

            .sidebar-user {
                padding: 16px 20px;
                border-top: 1px solid var(--border-color);
                display: flex;
                align-items: center;
                gap: 12px;
                background: #FFFFFF;
            }

            .user-avatar-circle {
                width: 36px;
                height: 36px;
                background: #F1F5F9;
                color: #475569;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 13px;
                font-weight: 600;
            }

            .user-details h4 {
                font-size: 13px;
                font-weight: 600;
                color: var(--text-main);
            }

            .user-details p {
                font-size: 11px;
                color: var(--text-muted);
            }

            .main-wrapper {
                margin-left: var(--sidebar-width);
                flex: 1;
                display: flex;
                flex-direction: column;
                min-height: 100vh;
            }

            .top-navbar {
                height: 64px;
                background: #FFFFFF;
                border-bottom: 1px solid var(--border-color);
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 32px;
                position: sticky;
                top: 0;
                z-index: 90;
            }

            .top-breadcrumb {
                font-size: 14px;
                font-weight: 600;
                color: var(--text-muted);
            }

            .top-actions {
                display: flex;
                align-items: center;
                gap: 16px;
            }

            .top-icon-btn {
                width: 36px;
                height: 36px;
                border-radius: 8px;
                border: 1px solid var(--border-color);
                background: #FFFFFF;
                display: flex;
                align-items: center;
                justify-content: center;
                color: var(--text-muted);
                cursor: pointer;
                transition: all 0.15s;
                text-decoration: none;
            }

            .top-icon-btn:hover {
                background: #F8FAFC;
                color: var(--text-main);
            }

            .page-body-container {
                padding: 32px;
                flex: 1;
            }
            </text>
        }
    </style>
    @RenderSection("styles", required: false)
</head>
<body>
@if (isStudent)
{
    <!-- KHUNG ĐIỆN THOẠI CHUẨN FIGMA CHO TÀI KHOẢN HỌC VIÊN -->
    <div class="mobile-phone-container">
        <!-- Thanh trạng thái tai thỏ / Dynamic Island -->
        <div class="phone-status-bar">
            <span class="phone-time">9:41</span>
            <div class="phone-notch"></div>
            <div class="phone-icons">
                <i class="fa-solid fa-signal"></i>
                <i class="fa-solid fa-wifi"></i>
                <i class="fa-solid fa-battery-full"></i>
            </div>
        </div>

        <!-- Header ứng dụng khớp Figma -->
        <div class="phone-app-header">
            <div class="user-greeting-box">
                <span class="greeting-sub">Chào buổi sáng</span>
                <h2 class="greeting-name">Hoàng Anh</h2>
            </div>
            <div class="header-right-actions">
                <div class="phone-user-avatar">HA</div>
                <a href="@Url.Action("Logout", "Account")" class="phone-logout-btn" title="Đăng xuất">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                </a>
            </div>
        </div>

        <!-- Nội dung màn hình cuộn mượt mà -->
        <div class="phone-screen-content">
            @RenderBody()
        </div>

        <!-- Thanh điều hướng dưới đáy khớp Figma -->
        <nav class="phone-bottom-nav">
            <a href="@Url.Action("Catalog", "Student")" class="phone-nav-tab @(currentController == "Student" && currentAction == "Catalog" ? "active" : "")">
                <i class="fa-regular fa-folder-closed"></i>
                <span>Đề thi</span>
            </a>
            <a href="@Url.Action("Room", "Student")" class="phone-nav-tab @(currentController == "Student" && currentAction == "Room" ? "active" : "")">
                <i class="fa-solid fa-pencil"></i>
                <span>Phòng thi</span>
            </a>
            <a href="@Url.Action("Result", "Student")" class="phone-nav-tab @(currentController == "Student" && currentAction == "Result" ? "active" : "")">
                <i class="fa-solid fa-chart-pie"></i>
                <span>Kết quả</span>
            </a>
        </nav>
    </div>
}
else
{
    <!-- GIAO DIỆN QUẢN TRỊ VIÊN DESKTOP CHO ADMIN -->
    <aside class="edutest-sidebar">
        <div class="sidebar-brand">
            <div class="brand-logo-badge">E</div>
            <div class="brand-text">
                <h2>EduTest</h2>
                <p>Exam workspace</p>
            </div>
        </div>

        <nav class="sidebar-menu">
            <div class="menu-section-title">QUẢN TRỊ ĐỀ THI</div>
            <a href="@Url.Action("Index", "Exam")" class="nav-item @(currentController == "Exam" && currentAction == "Index" ? "active" : "")">
                <i class="fa-solid fa-cloud-arrow-up"></i>
                <span>Import đề thi</span>
            </a>
            <a href="@Url.Action("Index", "Exam")#exam-list" class="nav-item @(currentController == "Exam" && currentAction == "Edit" ? "active" : "")">
                <i class="fa-regular fa-folder-closed"></i>
                <span>Kho đề thi</span>
            </a>

            <div class="menu-section-title">XEM THỬ NGƯỜI HỌC</div>
            <a href="@Url.Action("Catalog", "Student")" class="nav-item @(currentController == "Student" && currentAction == "Catalog" ? "active" : "")">
                <i class="fa-regular fa-rectangle-list"></i>
                <span>Danh sách đề</span>
            </a>
            <a href="@Url.Action("Room", "Student")" class="nav-item @(currentController == "Student" && currentAction == "Room" ? "active" : "")">
                <i class="fa-solid fa-pencil"></i>
                <span>Phòng thi</span>
            </a>
            <a href="@Url.Action("Result", "Student")" class="nav-item @(currentController == "Student" && currentAction == "Result" ? "active" : "")">
                <i class="fa-solid fa-chart-pie"></i>
                <span>Kết quả</span>
            </a>
        </nav>

        <div class="sidebar-user">
            <div class="user-avatar-circle">NL</div>
            <div class="user-details">
                <h4>Nguyễn Minh Lan</h4>
                <p>Giảng viên</p>
            </div>
        </div>
    </aside>

    <div class="main-wrapper">
        <header class="top-navbar">
            <div class="top-breadcrumb">Admin Interface Design · Quản trị đề thi</div>
            <div class="top-actions">
                <a href="@Url.Action("DownloadSample", "Exam")" class="top-icon-btn" title="Tải tệp mẫu chuẩn">
                    <i class="fa-regular fa-file-word"></i>
                </a>
                <a href="@Url.Action("Logout", "Account")" class="top-icon-btn" title="Đăng xuất">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                </a>
            </div>
        </header>

        <main class="page-body-container">
            @RenderBody()
        </main>
    </div>
}

@RenderSection("scripts", required: false)
</body>
</html>
